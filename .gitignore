# 大きな中間生成物はコミットしない(スクリプトで再生成できるようにしておくこと)
# GitHub は 1 ファイル 100MB 制限。パーティション化した parquet はここに足していく
data/**/*.parquet
data/**/*.arrow
data/raw/
*.npy
*.npz

# Python
__pycache__/
.venv/
*.pyc
.ipynb_checkpoints/

# 秘密情報 — 絶対にコミットしない
*.env
.env*
*.pem
*.key
secrets/

# OS
Thumbs.db
.DS_Store

# --- DRAM 統合分(2026-08-29) ---
# 旧 DRAM-microprice リポジトリは小さな成果物 parquet/npz/npy を版管理していた。
# data/DRAM/ 配下はそれを引き継ぐ(重い中間生成物の除外は data/DRAM/.gitignore が持つ)
!data/DRAM/**
